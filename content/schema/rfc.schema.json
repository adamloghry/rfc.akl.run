{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rfc.akl.run/schema/rfc.schema.json",
  "title": "RFC content file",
  "type": "object",
  "required": ["number"],
  "additionalProperties": true,
  "properties": {
    "number": { "type": "integer", "minimum": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "shortTitle": { "type": ["string", "null"] },
    "authors": { "type": "array", "items": { "type": "string" } },
    "organization": { "type": ["string", "null"] },
    "category": { "enum": ["core", "dns", "http", "transport", "security", "email", "routing", "applications", "infrastructure", "data", "meta"] },
    "categoryReviewed": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "subtitle": { "type": "string" },
    "summary": { "type": "string" },
    "eli5": {
      "type": "object",
      "properties": { "summary": { "type": "string" } },
      "additionalProperties": true
    },
    "questions": { "type": "array", "items": { "type": "string", "pattern": "^[^?]*$" } },
    "tldr": {
      "type": "object",
      "properties": {
        "problem": { "type": "string" },
        "mechanism": { "type": "string" },
        "outcome": { "type": "string" },
        "outcomeLabel": { "type": "string" }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": { "label": { "type": "string" }, "value": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "lineage": {
      "type": "object",
      "required": ["rfcs"],
      "properties": {
        "title": { "type": "string" },
        "rfcs": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      },
      "additionalProperties": false
    },
    "today": { "type": "string" },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "glossary": { "type": "array", "items": { "type": "string" } },
    "journeys": { "type": "array", "items": { "type": "string" } },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "content"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "number": { "type": ["string", "number"] },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "eli5": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "viz": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "data"],
        "properties": {
          "type": { "enum": ["packet", "sequence-sim", "sequence", "compare-table", "contrast", "key-grid", "layers", "timeline", "state-machine", "tree", "opcodes", "code"] },
          "id": { "type": "string" },
          "caption": { "type": "string" },
          "anchor": { "type": "string" },
          "position": { "enum": ["before", "after"] },
          "data": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "number": { "type": ["string", "number"] },
          "text": { "type": "string" },
          "rfc": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "hero": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "enum": ["human", "llm-draft"] },
        "model": { "type": "string" },
        "drafted": { "type": "string" },
        "reviewedBy": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "updated": { "type": "string" },
    "featured": { "type": "boolean" },
    "date": { "type": "string" },
    "status": { "type": "string" },
    "obsoletes": {},
    "obsoletedBy": {}
  }
}
