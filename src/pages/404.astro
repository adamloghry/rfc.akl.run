---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="No page here — rfc.akl.run" description="That page does not exist on rfc.akl.run." path="/404.html" palette="warm" header="reader" breadcrumb={[{ label: 'Not found' }]} robots="noindex, follow">
<div class="container container-index" style="padding:64px 0">
<h1>No page here</h1>
<p style="color:var(--muted)">That address doesn't match anything on rfc.akl.run. If you were after an RFC, enter its number.</p>
<form id="goto-form" action="/" method="get" style="display:flex;gap:8px;margin:24px 0">
<label for="goto-n" class="visually-hidden">RFC number</label>
<input id="goto-n" type="number" min="1" inputmode="numeric" placeholder="RFC number" style="padding:8px 12px;font:inherit">
<button class="btn" type="submit">Go to RFC</button>
</form>
<p><a href="/">Atlas</a> &middot; <a href="/areas">Areas</a></p>
<script is:inline>(function(){var f=document.getElementById('goto-form');if(!f)return;f.addEventListener('submit',function(e){e.preventDefault();var n=parseInt(document.getElementById('goto-n').value,10);if(n>0)location.assign('/rfc'+n);});})();</script>
</div>
</BaseLayout>
