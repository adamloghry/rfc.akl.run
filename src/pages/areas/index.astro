---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AreaCard from '../../components/pages/AreaCard.astro';
import { getSite } from '../../lib/site';
import { groups } from '../../components/pages/util';
const site = await getSite();
const g = groups(site);
---
<BaseLayout title="Areas · rfc.akl.run" description="Browse every RFC by area: core protocols, DNS, HTTP, transport, security, email, routing and more." path="/areas" palette="cool" header="site" container="atlas" active="areas">
<div class="container container-atlas page-head">
<p class="eyebrow">Browse</p>
<h1 class="page-title">Areas</h1>
<p class="page-lede">Every RFC belongs to one of eleven areas. Each area page lists its RFCs, with the ISO Plain Language explainers first.</p>
<div class="area-grid">{site.categories.map((c) => <AreaCard cat={c} list={g.get(c.key)} />)}</div>
</div>
</BaseLayout>
