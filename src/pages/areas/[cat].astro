---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexList from '../../components/pages/IndexList.astro';
import { getSite } from '../../lib/site';
import { DESCRIPTIONS, byPri, groups, strip, tally } from '../../components/pages/util';
export async function getStaticPaths() {
  const site = await getSite();
  return site.categories.map((c) => ({ params: { cat: c.key } }));
}
const site = await getSite();
const cat = site.categories.find((c) => c.key === Astro.params.cat)!;
const list = groups(site).get(cat.key)!;
const t = tally(list);
const expl = list.filter((r) => r.tier === 'explainer' || r.tier === 'interactive').sort(byPri);
const sums = list.filter((r) => r.tier === 'summary').sort(byPri);
const idx = list.filter((r) => r.tier === 'index');
const sub = (r: any) => strip((r.content && (r.content.subtitle || (r.content.hero && r.content.hero.subtitle))) || '');
const desc = DESCRIPTIONS[cat.key] || '';
---
<BaseLayout title={`${cat.name} · Areas · rfc.akl.run`} description={`${cat.name}: ${desc} ${t.total} RFCs.`.slice(0, 200)} path={`/areas/${cat.key}`} palette="cool" header="site" container="atlas" active="areas">
<div class="container container-atlas page-head">
<p class="eyebrow"><a href="/areas">Areas</a> / {cat.name}</p>
<h1 class="page-title">{cat.name}</h1>
<p class="page-lede">{desc}</p>
<p class="area-stats mono">{t.total} RFCs · {t.explainer + t.interactive} with ISO Plain Language · {t.summary} summaries · {t.index} index pages</p>
{expl.length > 0 && <section class="area-sec"><h2 class="sec-title">With ISO Plain Language <span class="count">{expl.length}</span></h2>
<div class="expl-grid">{expl.map((r) => <a class="expl-card" href={r.url}>
<span class="eyebrow">RFC {r.number}{r.tier === 'interactive' ? ' · interactive' : ''}</span>
<span class="expl-short">{r.shortTitle || r.title}</span>
<span class="expl-title">{r.shortTitle ? r.title : ''}</span>
<span class="expl-sub">{sub(r)}</span></a>)}</div></section>}
{sums.length > 0 && <section class="area-sec"><h2 class="sec-title">Summaries <span class="count">{sums.length}</span></h2>
<ul class="sum-rows">{sums.map((r) => <li><a href={r.url}><span class="mono num">RFC {r.number}</span><span class="sum-title">{r.title}</span><span class={`badge badge-${r.statusTone}`}>{r.statusLabel}</span></a></li>)}</ul></section>}
{idx.length > 0 && <section class="area-sec"><h2 class="sec-title">Index pages <span class="count">{idx.length}</span></h2><IndexList list={idx} /></section>}
</div>
</BaseLayout>
