---
// One page per number 1..max: Datasheet (RFC text + AI ELI5 tabs), IndexTier (RFC text under the index facts; no RFC renders it today, every issued RFC has an explainer) or NotIssued.
import Datasheet from '../components/rfc/Datasheet.astro';
import IndexTier from '../components/rfc/IndexTier.astro';
import NotIssued from '../components/rfc/NotIssued.astro';
import { getSite } from '../lib/site';

export async function getStaticPaths() {
  const site = await getSite();
  return Array.from({ length: site.max }, (_, i) => {
    const n = i + 1;
    const rfc = site.rfcs.get(n) ?? null;
    const kind = rfc ? rfc.tier : site.notIssued.has(n) ? 'not-issued' : 'reserved';
    return { params: { n: String(n) }, props: { rfc, kind, n } };
  });
}

const site = await getSite();
const { rfc, kind, n } = Astro.props;
---
{rfc && (kind === 'explainer' || kind === 'interactive') && <Datasheet rfc={rfc} site={site} />}
{rfc && (kind === 'index' || kind === 'summary') && <IndexTier rfc={rfc} site={site} withText />}
{!rfc && <NotIssued number={n} kind={kind as 'not-issued' | 'reserved'} max={site.max} />}
