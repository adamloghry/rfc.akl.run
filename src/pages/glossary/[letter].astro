---
import GlossaryLetter from '../../components/pages/GlossaryLetter.astro';
import { glossaryModel } from '../../lib/glossary';
import { getSite } from '../../lib/site';
export async function getStaticPaths() {
  const { pages, letters } = glossaryModel(await getSite());
  return pages.map((page) => ({ params: { letter: page.slug }, props: { page, letters } }));
}
const { page, letters } = Astro.props;
---
<GlossaryLetter page={page} letters={letters} />
