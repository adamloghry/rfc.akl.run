---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSite } from '../../lib/site';
const site = await getSite();
const letterOf = (t: { term: string }) => { const c = t.term.trim()[0].toUpperCase(); return /[A-Z]/.test(c) ? c : '#'; };
const terms = [...site.glossary.values()].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const letters = [...new Set(terms.map(letterOf))].sort();
const alpha = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', '#'];
---
<BaseLayout title="Glossary · rfc.akl.run" description="Networking terms from the RFCs, explained in plain language." path="/glossary/" palette="warm" header="reader" breadcrumb={[{ label: 'Glossary' }]}>
<div class="container container-index prose-page">
<p class="eyebrow">Reference</p>
<h1 class="page-title">Glossary</h1>
<p class="page-lede serif">{terms.length} terms, in plain language.</p>
<nav class="jump-bar" aria-label="Jump to letter">{alpha.map((l) => letters.includes(l) ? <a href={`#letter-${l}`}>{l}</a> : <span aria-hidden="true">{l}</span>)}</nav>
{letters.map((l) => <section class="gloss-group" id={`letter-${l}`}><h2 class="gloss-letter">{l}</h2><dl>{terms.filter((t) => letterOf(t) === l).map((t) => {
  const used = [...new Set([...(t.rfcs || []), ...(t.usedBy || [])])].sort((a, b) => a - b);
  return <div class="gloss-entry"><dt id={t.id}>{t.term}</dt><dd><Fragment set:html={t.definition || ''} />
{t.eli5 && <p class="gloss-eli5"><span class="eyebrow">Like I'm five</span> {t.eli5}</p>}
{used.length > 0 && <p class="gloss-used"><span class="eyebrow">Used in</span> {used.map((n) => <><a class="rfc-chip mono" href={`/${n}/`}>RFC {n}</a> </>)}</p>}</dd></div>;
})}</dl></section>)}
</div>
</BaseLayout>
