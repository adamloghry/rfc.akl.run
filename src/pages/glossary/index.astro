---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlossaryNav from '../../components/pages/GlossaryNav.astro';
import { glossaryForwarder, glossaryModel } from '../../lib/glossary';
import { getSite } from '../../lib/site';
const { total, letters, exceptions } = glossaryModel(await getSite());
---
<BaseLayout title="Glossary · rfc.akl.run" description="Networking terms from the RFCs, explained in plain language." path="/glossary" palette="warm" header="reader" breadcrumb={[{ label: 'Glossary' }]}>
<script slot="head" is:inline set:html={glossaryForwarder(exceptions)}></script>
<div class="container container-index prose-page">
<p class="eyebrow">Reference</p>
<h1 class="page-title">Glossary</h1>
<p class="page-lede serif">{total} terms, in plain language. Pick a letter.</p>
<GlossaryNav letters={letters} />
<ul class="gloss-index">{letters.filter((l) => l.count).map((l) => <li><a href={`/glossary/${l.slug}`}><span class="gloss-index-l">{l.label}</span><span class="gloss-index-n">{l.count} {l.count === 1 ? 'term' : 'terms'}</span></a></li>)}</ul>
</div>
</BaseLayout>
