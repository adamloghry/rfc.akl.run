---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSite } from '../../lib/site';
export async function getStaticPaths() {
  const site = await getSite();
  return site.journeys.map((j) => ({ params: { slug: j.slug } }));
}
const site = await getSite();
const j = site.journeys.find((x) => x.slug === Astro.params.slug)!;
const chip = (ref: { number: number; label?: string }) => {
  const r = site.rfcs.get(ref.number);
  return { number: ref.number, label: ref.label || (r && (r.shortTitle || r.title)) || '' };
};
---
<BaseLayout title={`${j.title} · Journeys · rfc.akl.run`} description={(j.description || j.title).slice(0, 200)} path={`/journeys/${j.slug}`} palette="warm" header="reader" breadcrumb={[{ label: 'Journeys', href: '/journeys' }, { label: j.title }]}>
<div class="container container-index prose-page">
<p class="eyebrow"><a href="/journeys">Journeys</a></p>
<h1 class="page-title">{j.title}</h1>
{j.description && <p class="page-lede serif">{j.description}</p>}
<ol class="journey-steps">{(j.steps || []).map((s, i) => <li class="journey-step" id={`step-${i + 1}`}>
<span class="step-num mono">{String(i + 1).padStart(2, '0')}</span>
<div class="step-body"><h2 class="step-title">{s.title}{s.subtitle && <> <span class="step-sub">{s.subtitle}</span></>}</h2>
{s.description && <p>{s.description}</p>}
<p class="chips">{(s.rfcs || []).map(chip).map((c) => <a class="rfc-chip" href={`/rfc${c.number}`}><span class="mono">RFC {c.number}</span>{c.label && <> <span>{c.label}</span></>}</a>)}</p></div></li>)}</ol>
</div>
</BaseLayout>
