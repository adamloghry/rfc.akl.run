---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/atlas/Hero.astro';
import MapSection from '../components/atlas/MapSection.astro';
import Journeys from '../components/atlas/Journeys.astro';
import Areas from '../components/atlas/Areas.astro';
import Timeline from '../components/atlas/Timeline.astro';
import { HASH_FORWARDER } from '../components/atlas/atlas-data';
import { getSite } from '../lib/site';
const site = await getSite();
const description = `Plain-language explainers, diagrams and simulations for the RFCs that built the Internet. A permanent page for every RFC number, 1–${site.max}.`;
---
<BaseLayout title="rfc.akl.run — the RFCs, explained" description={description} path="/" palette="cool" header="site" container="atlas" active="atlas">
  <script slot="head" is:inline set:html={HASH_FORWARDER}></script>
  <div class="container container-atlas at-main"><Hero /><MapSection site={site} /><Journeys site={site} /><Areas site={site} /><Timeline site={site} /></div>
</BaseLayout>
