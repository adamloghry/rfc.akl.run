---
// W0 placeholder: renders the title and tier for every RFC number. W1-A replaces the body with
// Datasheet | IndexTier | NotIssued.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite } from '../lib/site';

export async function getStaticPaths() {
  const site = await getSite();
  return Array.from({ length: site.max }, (_, i) => ({ params: { n: String(i + 1) } }));
}

const site = await getSite();
const number = Number(Astro.params.n);
const rfc = site.rfcs.get(number);
const title = rfc ? `RFC ${number}: ${rfc.shortTitle ? rfc.shortTitle + ': ' : ''}${rfc.title}` : `RFC ${number}`;
const kind = rfc ? rfc.tier : site.notIssued.has(number) ? 'not-issued' : 'reserved';
---
<BaseLayout title={`${title} · rfc.akl.run`} description={rfc?.abstract ?? ''} path={`/${number}/`} tier={kind}
  breadcrumb={[{ label: 'Index', href: '/areas/' }, { label: `RFC ${number}` }]}>
  <div class="container container-reader" style="padding:48px 0">
    <h1>{title}</h1>
    <p>Tier: {kind}</p>
  </div>
</BaseLayout>
