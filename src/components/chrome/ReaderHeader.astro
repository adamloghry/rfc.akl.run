---
import ThemeToggle from './ThemeToggle.astro';
import SearchBox from './SearchBox.astro';

export interface Props { breadcrumb?: { label: string; href?: string }[]; container: string }
const { breadcrumb = [], container } = Astro.props;
---
<header class="site-header site-header--reader">
<div class={`container container-${container} hdr-inner`}>
<a class="logo" href="/"><span class="logo-tile">R</span><span class="logo-word">rfc.akl.run</span></a>
<nav class="crumbs" aria-label="Breadcrumb">{breadcrumb.map((c, i) => {
  const last = i === breadcrumb.length - 1;
  return <>{i > 0 && <span class="crumb-sep" aria-hidden="true">/</span>}{last || !c.href
    ? <span class="crumb-current" aria-current={last ? 'page' : undefined}>{c.label}</span>
    : <a href={c.href}>{c.label}</a>}</>;
})}</nav>
<div class="hdr-grow"></div>
<SearchBox />
<a class="hdr-link" href="/areas/">Index</a>
<a class="hdr-link" href="/journeys/">Journeys</a>
<ThemeToggle />
</div>
</header>
