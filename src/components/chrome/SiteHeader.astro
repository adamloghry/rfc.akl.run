---
import ThemeToggle from './ThemeToggle.astro';

export interface Props { active?: string; container: string }
const { active, container } = Astro.props;
const NAV = [
  ['atlas', '/', 'Home'],
  ['journeys', '/journeys', 'Journeys'],
  ['areas', '/areas', 'Areas'],
  ['glossary', '/glossary', 'Glossary'],
];
---
<header class="site-header site-header--site">
<div class={`container container-${container} hdr-inner`}>
<a class="wordmark" href="/">rfc.akl.run</a>
<nav class="site-nav" aria-label="Main">{NAV.map(([key, href, label]) => <a href={href} aria-current={key === active ? 'page' : undefined}>{label}</a>)}</nav>
<div class="hdr-grow"></div>
<ThemeToggle />
</div>
</header>
