---
export interface Props { container: string }
const { container } = Astro.props;
const RFC_EDITOR = 'https://www.rfc-editor.org';
const ISO_PLAIN_LANGUAGE = 'https://www.iso.org/standard/78907.html';
const hasExtra = Astro.slots.has('default');
---
<footer class="site-footer">
<div class={`container container-${container}`}>
{hasExtra && <div class="footer-extra"><slot /></div>}
<div class="footer-copy"><span>RFC text © IETF Trust, from the <a href={RFC_EDITOR}>RFC Editor</a>. AI explainers are generated by AI to be <a href={ISO_PLAIN_LANGUAGE}>ISO Plain Language explanations</a> and are not deeply reviewed; the RFC text is authoritative.</span><a href="https://akl.run">akl.run</a></div>
</div>
</footer>
