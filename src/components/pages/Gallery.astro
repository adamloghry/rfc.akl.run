---
import Viz from '../viz/Viz.astro';
import { SAMPLES, SHAPES } from './contribute-data';
const items = Object.keys(SHAPES).map((t) => {
  let spec: any = null;
  if (SAMPLES[t]) { const { type, ...rest } = SAMPLES[t]; spec = { type, anchor: 'overview', position: 'after', data: rest }; }
  return { t, spec, rfc: spec ? { number: 0, content: { viz: [spec] } } : null };
});
---
{items.map(({ t, spec, rfc }) => <div class="gallery-item" data-gallery={t}><h3 class="gallery-type mono">{t}</h3><pre class="shape"><code>{SHAPES[t]}</code></pre>{spec ? <div class="gallery-live"><Viz spec={spec} rfc={rfc as any} /></div> : <p class="muted">Live example: see <a href="/903/">RFC 903</a>.</p>}</div>)}
