---
import { DESCRIPTIONS, tally } from './util';
const { cat, list } = Astro.props;
const t = tally(list);
---
<a class="area-card" href={`/areas/${cat.key}`}>
<span class="eyebrow">{t.total.toLocaleString('en-US')} RFCs</span>
<span class="area-card-name">{cat.name}</span>
<span class="area-card-desc">{DESCRIPTIONS[cat.key] || ''}</span>
<span class="area-card-meta">{t.explainer + t.interactive} with ISO Plain Language{t.summary > 0 && ` · ${t.summary} summaries`}</span>
</a>
