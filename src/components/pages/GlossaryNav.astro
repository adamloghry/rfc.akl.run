---
import type { LetterInfo } from '../../lib/glossary';
export interface Props { letters: LetterInfo[]; current?: string}
const { letters, current } = Astro.props;
---
<nav class="jump-bar" aria-label="Glossary letters">{letters.map((l) => l.count
  ? <a href={`/glossary/${l.slug}/`} aria-current={l.key === current ? 'page' : undefined} title={`${l.count} terms`}>{l.label}</a>
  : <span aria-hidden="true">{l.label}</span>)}</nav>
