---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlossaryNav from './GlossaryNav.astro';
import type { LetterInfo, GlossaryPage } from '../../lib/glossary';
export interface Props { page: GlossaryPage; letters: LetterInfo[] }
const { page, letters } = Astro.props;
const first = page.entries[0]?.term ?? '';
const last = page.entries[page.entries.length - 1]?.term ?? '';
const title = `Glossary: ${page.label}${page.parts > 1 ? ` (${page.part} of ${page.parts})` : ''} · rfc.akl.run`;
const slugOf = (part: number) => (part === 1 ? page.key : `${page.key}-${part}`);
---
<BaseLayout title={title} description={`Networking terms starting with ${page.label}, explained in plain language.`} path={`/glossary/${page.slug}`} palette="warm" header="reader" breadcrumb={[{ label: 'Glossary', href: '/glossary' }, { label: page.label }]}>
<div class="container container-index prose-page">
<p class="eyebrow">Glossary</p>
<h1 class="page-title">{page.label}</h1>
<p class="page-lede serif">{page.entries.length} terms{page.parts > 1 ? `, ${first} to ${last}` : ''}.</p>
<GlossaryNav letters={letters} current={page.key} />
<section class="gloss-group"><dl>{page.entries.map((t) => <div class="gloss-entry"><dt id={t.id}>{t.term}</dt><dd><Fragment set:html={t.definition} />
{t.eli5 && <p class="gloss-eli5"><span class="eyebrow">Like I'm five</span> {t.eli5}</p>}
{t.used.length > 0 && <p class="gloss-used"><span class="eyebrow">Used in</span> {t.used.map((n) => <><a class="rfc-chip mono" href={`/rfc${n}`}>RFC {n}</a> </>)}{t.more > 0 && <span class="gloss-more">and {t.more} more</span>}</p>}</dd></div>)}</dl></section>
{page.parts > 1 && <nav class="gloss-parts" aria-label="More terms starting with this letter">{Array.from({ length: page.parts }, (_, i) => i + 1).map((p) => p === page.part ? <span aria-current="page">{p}</span> : <a href={`/glossary/${slugOf(p)}`}>{p}</a>)}</nav>}
</div>
</BaseLayout>
