---
import type { Tally } from './util';
import { pct } from './util';
// rows: [label, tally, href?]
const { first, rows } = Astro.props as { first: string; rows: [string, Tally, string?][] };
---
<div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">{first}</th><th scope="col">RFCs</th><th scope="col">Index</th><th scope="col">Summary</th><th scope="col">Explainer</th><th scope="col">Interactive</th><th scope="col">Covered</th></tr></thead><tbody>{rows.map(([label, t, href]) => <tr><th scope="row">{href ? <a href={href}>{label}</a> : label}</th><td>{t.total}</td><td>{t.index}</td><td>{t.summary}</td><td>{t.explainer}</td><td>{t.interactive}</td><td>{pct(t.total - t.index, t.total)}</td></tr>)}</tbody></table></div>
