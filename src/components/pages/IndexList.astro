---
import { BLOCK, indexBlocks } from './util';
const { list } = Astro.props;
const { sorted, blocks } = indexBlocks(list);
const small = blocks.length <= 1 && sorted.length <= 300;
---
{small
  ? <ul class="idx-list">{sorted.map((r) => <li><a href={`/${r.number}/`}>RFC {r.number} · {r.title}</a></li>)}</ul>
  : blocks.map(([k, rs], i) => <details class="idx-block" open={i === 0 && blocks.length === 1 ? true : undefined}>
<summary><span class="mono">{k * BLOCK + 1}–{(k + 1) * BLOCK}</span> <span class="muted">{rs.length} RFCs</span></summary>
<ul class="idx-list">{rs.map((r) => <li><a href={`/${r.number}/`}>RFC {r.number} · {r.title}</a></li>)}</ul>
</details>)}
