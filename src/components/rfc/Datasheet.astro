---
/** Explainer / interactive RFC page. Pre-rendered datasheet. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { RfcRecord, Site } from '../../lib/model';
import * as areas from '../../lib/areas';
import DatasheetBand from './DatasheetBand.astro';
import ObsoletedBanner from './ObsoletedBanner.astro';
import Tldr from './Tldr.astro';
import Section from './Section.astro';
import References from './References.astro';
import LeftRail from './LeftRail.astro';
import RightRail from './RightRail.astro';
import Viz from '../viz/Viz.astro';
import RfcText from './RfcText.astro';
import AiNotice from './AiNotice.astro';
import type { RfcFile } from '../../lib/rfc-text';
import { describe, displayTitle, hasRightRail, plain, sectionHasBody } from './util';
export interface Props { rfc: RfcRecord; site: Site; file?: RfcFile | null }
const NOSCRIPT = '<noscript><style>#cite[hidden]{display:block}</style></noscript>';
const { rfc, site } = Astro.props;
const c = rfc.content || {};
// viz grouped by anchor section; unmatched ones render before References
const allSections: any[] = c.sections || [];
const anchored = new Set((c.viz || []).map((v: any) => v.anchor));
// A section with a title but no prose and no diagram would be a dangling heading: leave it out (the TOC follows).
const sections: any[] = allSections.filter((s) => sectionHasBody(s, anchored.has(s.id)));
const hasLevels = sections.some((s) => plain(s.plainLanguage));
const n = rfc.number;
const title = displayTitle(rfc);

const vizBySection = new Map<string, { before: any[]; after: any[] }>();
const orphans: any[] = [];
const ids = new Set(sections.map((s) => s.id));
for (const spec of c.viz || []) {
  if (!ids.has(spec.anchor)) { orphans.push(spec); continue; }
  if (!vizBySection.has(spec.anchor)) vizBySection.set(spec.anchor, { before: [], after: [] });
  vizBySection.get(spec.anchor)![spec.position === 'before' ? 'before' : 'after'].push(spec);
}

const toc = sections.map((s, i) => ({ id: s.id, n: s.number || String(i + 1), title: s.title }));
const refs: any[] = (c.references || []).filter((r: any) => plain(r.text));
if (refs.length) toc.push({ id: 'references', n: String(sections.length + 1), title: 'References' });
const rail = hasRightRail(rfc, site);
// Ids of the AI panel (locked permalinks); the RFC text avoids them.
const reserved = new Set<string>([...ids, 'tldr', 'references', 'top']);

const firstViz = (c.viz || []).find((v: any) => v.type === 'packet' && ((v.data || v).fields || []).length);
const permalink = firstViz ? `field-${(firstViz.data || firstViz).fields[0].key}` : (sections[0] ? sections[0].id : 'top');
---
<BaseLayout title={`RFC ${n} — ${title} · rfc.akl.run`} description={describe(rfc)} path={`/rfc${n}`} palette="warm" header="reader"
  breadcrumb={[{ label: areas.name(rfc.category), href: `/areas/${rfc.category}` }, { label: `RFC ${n}` }]} ogType="article" tier={rfc.tier}>
<Fragment slot="head"><Fragment set:html={NOSCRIPT} /></Fragment>
<DatasheetBand rfc={rfc} site={site} />
<ObsoletedBanner rfc={rfc} site={site} />
<div class="rt-tabs" data-tabs>
<div class="container container-reader">
<div class="tablist" role="tablist" aria-label={`RFC ${n}`} hidden>
<button type="button" role="tab" id="tab-text" aria-controls="rfc-text" aria-selected="true" data-tab="text"><span class="tab-name">RFC text</span><span class="tab-sub">the original</span></button>
<button type="button" role="tab" id="tab-plain-language" aria-controls="plain-language" aria-selected="false" tabindex="-1" data-tab="plain-language"><span class="tab-name">ISO Plain Language</span><span class="tab-sub">AI-generated bonus</span></button>
</div>
</div>
<section id="rfc-text" class="rt-panel" role="tabpanel" aria-labelledby="tab-text" data-tab-panel="text">
<div class="container container-reader"><h2 class="panel-h">RFC text</h2></div>
<RfcText rfc={rfc} site={site} file={Astro.props.file} reserved={reserved} />
</section>
<section id="plain-language" class="rt-panel" role="tabpanel" aria-labelledby="tab-plain-language" data-tab-panel="plain-language">
<div class="container container-reader"><h2 class="panel-h">ISO Plain Language</h2><AiNotice rfc={rfc} /></div>
<div class={`container container-reader body-grid${rail ? '' : ' no-right'}`}>
{toc.length > 0 && <details class="toc-disclosure"><summary>On this page</summary><nav aria-label="On this page">{toc.map((t) => <a href={`#${t.id}`}><span class="toc-n">{t.n}</span>{t.title}</a>)}</nav></details>}
<LeftRail hasLevels={hasLevels} toc={toc} number={n} permalink={permalink} />
<div class="main-col">
<Tldr tldr={c.tldr} />
{sections.map((s, i) => <Section section={s} index={i} hasLevels={hasLevels} rfc={rfc} before={vizBySection.get(s.id)?.before ?? []} after={vizBySection.get(s.id)?.after ?? []} />)}
{orphans.map((spec) => <Viz spec={spec} rfc={rfc} />)}
<References refs={refs} site={site} n={sections.length + 1} />
</div>
{rail && <RightRail rfc={rfc} site={site} />}
</div>
</section>
</div>
<Fragment slot="footer"><div class="rd-foot"><span><span class="rd-foot-n">RFC {n}</span> — {title}</span><div class="rd-foot-nav">{n > 1 && <a href={`/rfc${n - 1}`}>← RFC {n - 1}</a>}{n < site.max && <a href={`/rfc${n + 1}`}>RFC {n + 1} →</a>}</div></div></Fragment>
<script>import '../../scripts/reader';
import '../../scripts/tabs';</script>
</BaseLayout>
