---
import type { RfcRecord, Site } from '../../lib/model';
import * as graph from '../../lib/graph';
import { upper } from './util';
export interface Props { rfc: RfcRecord; site: Site }
const { rfc, site } = Astro.props;
const lin = graph.lineage(rfc, site);
---
{lin.items.length >= 2 && (
<div class="container container-reader lineage" aria-label="Lineage">
<div class="lineage-head"><span class="eyebrow">LINEAGE · {!lin.title || lin.title === 'Lineage' ? 'FROM THE RFC INDEX' : upper(lin.title)}</span><a href={`/graph#${rfc.number}`}>Open full graph →</a></div>
<div class="lineage-scroll"><div class="lineage-rail" style={`--n:${lin.items.length}`}>{lin.items.map((n) => {
  const current = n.number === rfc.number;
  return <a class={`lin-node${current ? ' is-current' : ''}`} href={n.url} aria-current={current ? 'page' : undefined}><span class="lin-dot">'{String(n.year % 100).padStart(2, '0')}</span><span class="lin-num">RFC {n.number}</span><span class="lin-label">{n.label}</span></a>;
})}</div></div>
</div>
)}
