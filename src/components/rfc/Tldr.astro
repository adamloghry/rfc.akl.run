---
import { upper } from './util';
export interface Props { tldr: any }
const t = Astro.props.tldr;
const cells = t ? [['Problem', t.problem], ['Mechanism', t.mechanism], [t.outcomeLabel || 'Outcome', t.outcome]] : [];
---
{t && (
<section class="tldr" id="tldr" aria-label="Summary">{cells.map(([label, text]) => <div class="tldr-cell"><span class="eyebrow">{upper(label)}</span><span class="tldr-text">{text}</span></div>)}</section>
)}
