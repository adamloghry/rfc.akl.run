---
import type { RfcRecord, Site } from '../../lib/model';
import * as areas from '../../lib/areas';
import CiteBlock from './CiteBlock.astro';
import MetaList from './MetaList.astro';
import LineageStrip from './LineageStrip.astro';
import { displayTitle, upper } from './util';
export interface Props { rfc: RfcRecord; site: Site }
const { rfc, site } = Astro.props;
const c = rfc.content || {};
const n = rfc.number;
const tags = c.tags && c.tags.length ? c.tags.join(' · ') : areas.name(rfc.category);
const subtitle = c.subtitle || (c.hero && c.hero.subtitle) || '';
---
<section class="band">
<div class="container container-reader band-grid">
<div class="band-main">
<div class="badges">
<span class="badge badge-solid">RFC {n}</span>
<span class={'badge badge-' + rfc.statusTone}>{upper(rfc.statusLabel)}</span>
<span class="badge badge-neutral">{upper(tags)}</span>
{rfc.isNew && <span class="badge badge-new">NEW</span>}
</div>
<h1>{displayTitle(rfc)}</h1>
{subtitle && <p class="subtitle">{subtitle}</p>}
<div class="band-actions">
<button class="btn btn-solid" type="button" data-copy={`https://rfc.akl.run/rfc${n}`} data-copy-label="Copy link">Copy link</button>
<button class="btn" type="button" aria-expanded="false" aria-controls="cite" data-cite-toggle>Cite</button>
<a class="btn" href={`https://www.rfc-editor.org/rfc/rfc${n}.html`}>On rfc-editor.org ↗</a>
</div>
<CiteBlock rfc={rfc} />
</div>
<MetaList rfc={rfc} site={site} />
</div>
<LineageStrip rfc={rfc} site={site} />
</section>
