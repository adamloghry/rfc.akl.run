---
import type { Site } from '../../lib/model';
export interface Props { refs: any[]; site: Site; n: number }
const { refs, site, n } = Astro.props;
const rows = refs.map((r) => {
  const m = r.rfc || (/RFC\s?(\d+)/.exec(r.text || '') || [])[1];
  const num = m ? Number(m) : null;
  const known = num ? site.rfcs.get(num) : null;
  const link = !!num && num <= site.max && !r.url;
  return { r, num, known, link };
});
---
{refs.length > 0 && (
<section class="sec" id="references">
<h2><a class="sec-anchor" href="#references" aria-label="Permalink to references">§{n}</a>References</h2>
<div class="refs">{rows.map(({ r, num, known, link }) => {
  const cells = <Fragment><span class="ref-n">{r.number || ''}</span><span class="ref-rfc">{num ? `RFC ${num}` : ''}</span><span class="ref-text">{r.text}</span><span class="ref-date">{known ? known.dateLabel : ''}</span></Fragment>;
  return link ? <a class="ref-row" href={`/${num}/`}>{cells}</a> : <div class="ref-row">{cells}</div>;
})}</div>
</section>
)}
