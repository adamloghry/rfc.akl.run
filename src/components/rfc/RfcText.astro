---
/**
 * The original RFC text, typeset: normalized (no page-break noise), headings with permalinks, RFC and Section
 * references linked, plus a table-of-contents rail. Pure server-rendered HTML: the text is in the DOM without JS.
 */
import type { RfcRecord, Site } from '../../lib/model';
import { normalizeRfcText, type RfcFile, readRfcFile, renderRfcText } from '../../lib/rfc-text';
export interface Props {
  rfc: RfcRecord;
  site: Site;
  /** Override for tests: the parsed text file, or null for "no text available". Default: data/rfc-text/<n>.txt. */
  file?: RfcFile | null;
  /** Ids used by the other panel on the page. */
  reserved?: ReadonlySet<string>;
}
const { rfc, site } = Astro.props;
const n = rfc.number;
const file = Astro.props.file === undefined ? readRfcFile(n) : Astro.props.file;
const rendered = file ? renderRfcText(normalizeRfcText(file.body), { self: n, issued: (k) => site.rfcs.has(k), reserved: Astro.props.reserved }) : null;
const toc = (rendered?.headings ?? []).filter((h) => h.depth <= 2).map((h) => ({ ...h, label: h.label.replace(/^Appendix /, '') }));
const editorUrl = file?.note ? `https://www.rfc-editor.org/rfc/rfc${n}.pdf` : `https://www.rfc-editor.org/rfc/rfc${n}.html`;
---
<div class={`container container-reader body-grid no-right rt-grid${toc.length ? '' : ' no-toc'}`}>
{toc.length > 0 && <details class="toc-disclosure"><summary>Contents</summary><nav aria-label="RFC text contents">{toc.map((h) => <a href={`#${h.id}`}><span class="toc-n">{h.label}</span>{h.title}</a>)}</nav></details>}
{toc.length > 0 && (
<aside class="rail rail-left rt-rail">
<nav class="toc rt-toc" aria-label="RFC text contents">{toc.map((h) => <a href={`#${h.id}`} data-toc={h.id} class={h.depth > 1 ? 'rt-sub' : undefined}><span class="toc-n">{h.label}</span><span class="toc-t">{h.title}</span></a>)}</nav>
</aside>
)}
<div class="main-col rt-main">
<div class="rt-bar">
<span class="eyebrow">Original text · RFC Editor</span>
<a class="rt-ext" href={editorUrl}>View on rfc-editor.org ↗</a>
</div>
{file?.note && <p class="rt-note" role="note">This text was converted from the RFC Editor's PDF edition and may contain conversion errors; the layout is approximate. The PDF is the reference copy.</p>}
{rendered
  ? <pre class="rt-pre" tabindex="0" aria-label={`Text of RFC ${n}`} set:html={rendered.html} />
  : <p class="rt-note" role="note">The text of RFC {n} is not included in this build. <a href={editorUrl}>Read it on rfc-editor.org</a>.</p>}
</div>
</div>
