---
import type { RfcRecord } from '../../lib/model';
import Viz from '../viz/Viz.astro';
export interface Props { section: any; index: number; hasLevels: boolean; rfc: RfcRecord; before: any[]; after: any[] }
const { section: s, index: i, hasLevels, rfc, before, after } = Astro.props;
const num = s.number || String(i + 1);
const levels = hasLevels && !!s.plainLanguage;
---
<section class="sec" id={s.id}>
<h2><a class="sec-anchor" href={`#${s.id}`} aria-label={`Permalink to section ${num}`}>§{num}</a>{s.title}</h2>
{before.map((spec) => <Viz spec={spec} rfc={rfc} />)}
{levels
  ? <Fragment><div class="prose" data-level="std" set:html={s.content || ''} /><div class="prose plainLanguage" data-level="plain-language" set:html={s.plainLanguage} /></Fragment>
  : <div class="prose" set:html={s.content || ''} />}
{after.map((spec) => <Viz spec={spec} rfc={rfc} />)}
</section>
