---
import type { RfcRecord, Site } from '../../lib/model';
import * as graph from '../../lib/graph';
import { shortLabel } from './util';
export interface Props { rfc: RfcRecord; site: Site }
const { rfc, site } = Astro.props;
const list = rfc.obsoletedBy.map((n) => site.rfcs.get(n)).filter((r): r is RfcRecord => !!r).sort(graph.byDate);
const nums = list.length ? list.map((r) => r.number) : rfc.obsoletedBy;
// newest by date; on a tie the lowest number (2616 -> 7230, not 7235)
const newest = list.length ? list.reduce((a, b) => (graph.pubDate(b) > graph.pubDate(a) ? b : a)) : null;
const last = newest ? newest.number : nums[nums.length - 1];
---
{rfc.obsoletedBy.length > 0 && (
<aside class="obs-banner" role="note"><strong>Obsoleted by</strong> {nums.map((n, i) => { const r = site.rfcs.get(n); return <Fragment>{i > 0 && '; '}<a href={`/rfc${n}`}>RFC {n}</a>{r && `, ${r.dateLabel}`}</Fragment>; })}.
<span class="obs-help"><strong>Which version should I read?</strong> Start with <a href={`/rfc${last}`}>RFC {last}</a>{newest && ` (${shortLabel(newest)})`}; this page is kept for history.</span></aside>
)}
