---
import type { RfcRecord, Site } from '../../lib/model';
import { CAP, hasExplainer } from './itutil';
import { uniq } from './util';
export interface Props { rfc: RfcRecord; site: Site }
const { rfc, site } = Astro.props;
const left = uniq([...rfc.obsoletes, ...rfc.updates]);
const right = uniq([...rfc.obsoletedBy, ...rfc.updatedBy]);
const lLabel = rfc.obsoletes.length && rfc.updates.length ? 'OBSOLETES / UPDATES' : rfc.obsoletes.length ? 'OBSOLETES' : 'UPDATES';
const cell = (nums: number[]) => nums.slice(0, CAP).map((n) => ({ n, t: site.rfcs.get(n) }));
const more = (nums: number[]) => nums.length - CAP;
---
<section class="it-sec">
<div class="it-row"><span class="it-eye">LINEAGE · GENERATED FROM RFC-INDEX.XML</span><a class="it-sm" href={`/graph#${rfc.number}`}>Open full graph →</a></div>
<div class="it-lin">
{[[lLabel, left, 'None'], null, ['UPDATED / OBSOLETED BY', right, 'None — current']].map((c) => c === null
  ? <div class="it-me">{rfc.number}</div>
  : <div class="it-c"><span class="it-eye">{c[0] as string}</span>{(c[1] as number[]).length
      ? <Fragment>{cell(c[1] as number[]).map(({ n, t }) => <a class="it-n" href={`/rfc${n}`}><b>RFC {n}</b>{t && ` ${t.shortTitle || t.title}`}{hasExplainer(t) && ' · has explainer'}</a>)}{more(c[1] as number[]) > 0 && <a class="it-n" href={`/graph#${rfc.number}`}>and {more(c[1] as number[])} more →</a>}</Fragment>
      : <span class="it-none">{c[2] as string}</span>}</div>)}
</div>
</section>
