---
import { glossaryModel } from '../../lib/glossary';
import type { RfcRecord, Site } from '../../lib/model';
export interface Props { rfc: RfcRecord; site: Site }
const { rfc, site } = Astro.props;
const c = rfc.content || {};
// Ids without a glossary entry would link to a missing anchor; skip them (lint reports them).
const terms = (c.glossary || []).filter((id: string) => site.glossary.has(id)).map((id: string) => ({ id, term: site.glossary.get(id)!.term }));
const gloss = glossaryModel(site);
const cards = rfc.journeys.map((slug) => {
  const j = site.journeys.find((x) => x.slug === slug);
  if (!j) return null;
  const steps = j.steps || [];
  const all = new Set<number>();
  steps.forEach((s) => (s.rfcs || []).forEach((r) => all.add(r.number)));
  const at = steps.findIndex((s) => (s.rfcs || []).some((r) => r.number === rfc.number));
  return { slug, title: j.title, count: all.size, at, total: steps.length };
}).filter(Boolean) as { slug: string; title: string; count: number; at: number; total: number }[];
const impls: any[] = c.implementations || [];
---
<aside class="rail rail-right">
{c.eli5 && c.eli5.summary && <div class="pullquote"><span class="eyebrow">ELI5</span><div class="pq-text" set:html={c.eli5.summary} /></div>}
{c.today && <div class="rail-block"><span class="eyebrow">WHERE YOU'LL MEET IT TODAY</span><div class="rail-text" set:html={c.today} /></div>}
{terms.length > 0 && <div class="rail-block ruled"><span class="eyebrow">GLOSSARY ON THIS PAGE</span><div class="chips">{terms.map((t: any) => <a class="chip" href={gloss.hrefs.get(t.id)}>{t.term}</a>)}</div></div>}
{cards.length > 0 && <div class="rail-block ruled"><span class="eyebrow">PART OF JOURNEY</span>{cards.map((j) => <a class="jcard" href={`/journeys/${j.slug}`}><span class="jcard-title">{j.title}</span><span class="jcard-meta">{j.count} RFCs{j.at >= 0 ? ` · step ${j.at + 1} of ${j.total}` : ''}</span></a>)}</div>}
{impls.length > 0 && <div class="rail-block ruled"><span class="eyebrow">IMPLEMENTATIONS</span><ul class="impl">{impls.map((im) => <li>{im.url ? <a href={im.url}>{im.name}</a> : im.name}{im.note ? ` — ${im.note}` : ''}</li>)}</ul></div>}
{rfc.mentionedIn.length > 0 && <div class="rail-block ruled"><span class="eyebrow">MENTIONED IN</span><div class="chips">{rfc.mentionedIn.slice(0, 8).map((n) => <a class="chip" href={`/rfc${n}`}>RFC {n}</a>)}</div></div>}
{c.provenance && c.provenance.source === 'llm-draft' && <p class="draft-note">Draft · machine-assisted, not yet reviewed</p>}
</aside>
