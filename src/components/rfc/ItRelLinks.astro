---
import type { RfcRecord, Site } from '../../lib/model';
import { CAP } from './itutil';
export interface Props { nums: number[]; rfc: RfcRecord; site: Site; withTitles?: boolean }
const { nums, rfc, site, withTitles = false } = Astro.props;
const shown = nums.slice(0, CAP);
---
{shown.map((n, i) => { const t = withTitles ? site.rfcs.get(n) : undefined; return <Fragment>{i > 0 && ', '}<a href={`/${n}/`}>RFC {n}</a>{t && ` — ${t.shortTitle || t.title}`}</Fragment>; })}{nums.length > CAP && <Fragment>, <a href={`/graph/#${rfc.number}`}>and {nums.length - CAP} more</a></Fragment>}
