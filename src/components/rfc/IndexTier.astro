---
/** Index / summary RFC page. Pre-rendered index tier. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { RfcRecord, Site } from '../../lib/model';
import * as areas from '../../lib/areas';
import ItRelLinks from './ItRelLinks.astro';
import ItFacts from './ItFacts.astro';
import ItLineage from './ItLineage.astro';
import ItMentioned from './ItMentioned.astro';
import { MONTHS } from './itutil';
import { plain } from './util';
export interface Props { rfc: RfcRecord; site: Site }
const { rfc, site } = Astro.props;
const n = rfc.number;
const summary: string = (rfc.tier === 'summary' && rfc.content && rfc.content.summary) || '';
const eli5: string = (summary && rfc.content!.eli5 && rfc.content!.eli5.summary) || '';
const draft = !!(rfc.content && rfc.content.provenance && rfc.content.provenance.source === 'llm-draft');
const absParas = rfc.abstract ? rfc.abstract.split(/\n\n+/) : [];
const tone = rfc.statusTone === 'green' ? 'badge-green' : rfc.statusTone === 'amber' ? 'badge-amber' : 'badge-neutral';
const monoNote = summary
  ? (draft ? 'Draft · machine-assisted, not yet reviewed' : 'Summary written for rfc.akl.run')
  : (rfc.abstract ? 'Abstract from the RFC Editor index' : 'No abstract in the RFC Editor index');
const ob = rfc.obsoletedBy;
const title = rfc.title;
const desc = plain(summary || rfc.abstract || title).slice(0, 200);
---
<BaseLayout title={`RFC ${n} — ${rfc.shortTitle || title} · rfc.akl.run`} description={desc} path={`/${n}/`} palette="warm" header="reader" container="index"
  breadcrumb={[{ label: areas.name(rfc.category), href: `/areas/${rfc.category}/` }, { label: `RFC ${n}` }]} ogType="article" tier={rfc.tier}>
<div class="it container container-index">
{ob.length > 0 && <div class="it-warn" role="note"><b>Obsoleted</b> by <ItRelLinks nums={ob} rfc={rfc} site={site} />. Prefer the newer RFC.</div>}
<section class="it-hero">
<div class="it-main">
<div class="it-badges"><span class="badge badge-solid">RFC {n}</span><span class={`badge ${tone}`}>{rfc.statusLabel.toUpperCase()}</span><span class="badge badge-dashed">{rfc.tier === 'index' ? 'INDEX PAGE' : 'SUMMARY'}</span>{rfc.isNew && <span class="badge badge-new">NEW · {MONTHS[rfc.month - 1]} {rfc.year}</span>}</div>
<h1 class="it-h1">{title}</h1>
{summary ? <div class="it-lede" set:html={summary} /> : absParas.length > 0 ? <div class="it-lede">{absParas.map((p) => <p>{p}</p>)}</div> : null}
<span class="it-mono">{monoNote}</span>
{eli5 && <div class="it-eli5"><span class="it-eye">Like I'm 5</span><Fragment set:html={eli5} /></div>}
{summary && absParas.length > 0 && <div class="it-abs"><span class="it-eye">AUTHORS' ABSTRACT</span>{absParas.map((p) => <p>{p}</p>)}</div>}
<div class="it-btns"><a class="btn btn-solid" href={`https://www.rfc-editor.org/rfc/rfc${n}.html`}>Read the RFC ↗</a><a class="btn" href={`https://datatracker.ietf.org/doc/rfc${n}/`}>Datatracker ↗</a></div>
</div>
<ItFacts rfc={rfc} site={site} />
</section>
<ItLineage rfc={rfc} site={site} />
<section class="it-two"><ItMentioned rfc={rfc} site={site} /></section>
</div>
<Fragment slot="footer"><span>rfc.akl.run/{n}/</span><span class="it-pn">{n > 1 && <a href={`/${n - 1}/`}>← RFC {n - 1}</a>}{n < site.max && <a href={`/${n + 1}/`}>RFC {n + 1} →</a>}</span></Fragment>
</BaseLayout>
