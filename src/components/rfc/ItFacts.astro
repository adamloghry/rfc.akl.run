---
import type { RfcRecord, Site } from '../../lib/model';
import * as areas from '../../lib/areas';
import ItRelLinks from './ItRelLinks.astro';
export interface Props { rfc: RfcRecord; site: Site }
const { rfc, site } = Astro.props;
const stream = [rfc.stream, rfc.wg].filter(Boolean).join(' · ');
---
<dl class="it-dl">
<dt>PUBLISHED</dt><dd>{rfc.dateLabel}</dd>
<dt>{rfc.authors.length > 1 ? 'AUTHORS' : 'AUTHOR'}</dt><dd>{rfc.authors.join(', ')}</dd>
{stream && <Fragment><dt>STREAM</dt><dd>{stream}</dd></Fragment>}
{!rfc.categoryReviewed && <Fragment><dt>AREA (GUESSED)</dt><dd><a href={`/areas/${rfc.category}/`}>{areas.name(rfc.category)}</a> <span class="it-mono">· from IETF area, unreviewed</span></dd></Fragment>}
{rfc.obsoletes.length > 0 && <Fragment><dt>OBSOLETES</dt><dd><ItRelLinks nums={rfc.obsoletes} rfc={rfc} site={site} withTitles={rfc.obsoletes.length <= 2} /></dd></Fragment>}
{rfc.updates.length > 0 && <Fragment><dt>UPDATES</dt><dd><ItRelLinks nums={rfc.updates} rfc={rfc} site={site} withTitles={rfc.updates.length <= 2} /></dd></Fragment>}
{rfc.doi && <Fragment><dt>DOI</dt><dd><span class="it-mono">{rfc.doi}</span></dd></Fragment>}
</dl>
