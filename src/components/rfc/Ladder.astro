---
import type { RfcRecord } from '../../lib/model';
import { LADDER, TIER_LEVEL } from './itutil';
export interface Props { rfc: RfcRecord }
const { rfc } = Astro.props;
const reached = TIER_LEVEL[rfc.tier] || 1;
---
<section class="it-sec">
<div class="it-row"><span class="it-eye">COVERAGE FOR THIS RFC</span>{rfc.demand > 0 && <span class="it-sm">{rfc.demand} {rfc.demand === 1 ? 'reader' : 'readers'} requested an explainer · counted daily</span>}</div>
<div class="it-lad">{LADDER.map(([label, hint], i) => {
  const done = i < reached, next = i === reached;
  return <div class={next ? 'it-cell it-next' : 'it-cell'}><div class="it-ch"><span class={done ? 'it-dot it-done' : next ? 'it-dot it-nx' : 'it-dot'}>{done ? '✓' : String(i + 1)}</span><b>{label}</b></div><span>{hint}</span></div>;
})}</div>
</section>
