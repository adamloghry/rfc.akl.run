---
import type { RfcRecord, Site } from '../../lib/model';
import { CAP } from './itutil';
export interface Props { rfc: RfcRecord; site: Site }
const { rfc, site } = Astro.props;
const rows = rfc.mentionedIn.slice(0, CAP).map((n) => ({ n, t: site.rfcs.get(n) }));
const journeys = (rfc.journeys || []).map((slug) => (site.journeys || []).find((x) => x.slug === slug)).filter(Boolean) as { slug: string; title: string }[];
const more = rfc.mentionedIn.length - CAP;
const any = rows.length + journeys.length + (more > 0 ? 1 : 0) > 0;
---
{any && (
<div class="it-box it-ment"><span class="it-eye">MENTIONED IN</span>{rows.map(({ n, t }) => <a href={`/rfc${n}`}><span>{t ? t.shortTitle || t.title : `RFC ${n}`}</span><i>{n}</i></a>)}{journeys.map((j) => <a href={`/journeys/${j.slug}`}><span>Journey · {j.title}</span><i>journey</i></a>)}{more > 0 && <a href={`/graph#${rfc.number}`}><span>and {more} more</span><i>→</i></a>}</div>
)}
