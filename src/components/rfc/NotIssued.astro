---
/** Numbers with no RFC: never issued (skipped) or reserved (not yet published). Reproduces scripts/templates/not-issued.js. */
import BaseLayout from '../../layouts/BaseLayout.astro';
export interface Props { number: number; kind: 'not-issued' | 'reserved'; max: number }
const COPY = {
  'not-issued': {
    label: 'NEVER ISSUED',
    line: 'The RFC Editor skipped this number; no document was ever published under it.',
    title: 'never issued',
  },
  reserved: {
    label: 'NOT YET PUBLISHED',
    line: "This number is assigned but the RFC hasn't been published yet. Check back after the next nightly build.",
    title: 'not yet published',
  },
};
const { number, kind, max } = Astro.props;
const c = COPY[kind];
if (!c) throw new Error(`NotIssued: unknown kind ${kind}`);
const prev = number > 1 ? number - 1 : null;
const next = number < (max || number) ? number + 1 : null;
---
<BaseLayout title={`RFC ${number} (${c.title}) — rfc.akl.run`} description={`RFC ${number} was ${c.title}. ${c.line}`} path={`/${number}/`} palette="warm" header="reader"
  breadcrumb={[{ label: 'Index', href: '/areas/' }, { label: `RFC ${number}` }]} robots="noindex, follow" tier="not-issued">
<div class="container container-index">
<div class="it-head" style="padding:48px 0 24px">
<span class="badge badge-solid mono">RFC {number}</span>
<span class="badge badge-dashed">{c.label}</span>
<h1 class="ni-title" style="margin:20px 0 8px">RFC {number} was {c.title}</h1>
<p class="ni-line" style="color:var(--muted);max-width:60ch">{c.line}</p>
</div>
<nav class="ni-nav" aria-label="Neighbouring RFCs" style="display:flex;gap:16px;padding:16px 0 48px">
{prev && <a href={`/${prev}/`} rel="prev">&larr; RFC {prev}</a>}
{next && <a href={`/${next}/`} rel="next">RFC {next} &rarr;</a>}
<a href="/">Atlas</a>
</nav>
</div>
</BaseLayout>
