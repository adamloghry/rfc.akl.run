---
import type { RfcRecord } from '../../lib/model';
export interface Props { rfc: RfcRecord }
const { rfc } = Astro.props;
const p = rfc.content?.provenance;
const human = p?.source === 'human';
---
<aside class="ai-note" role="note">
{human
  ? <Fragment><strong>Explainer written for rfc.akl.run.</strong> It is a reading aid, not part of the RFC. The RFC text is the authoritative source.</Fragment>
  : <Fragment><strong>AI-generated explainer.</strong> Written by AI from the RFC text following ISO Plain Language guidelines and not reviewed by a human. It may contain mistakes. The RFC text is the authoritative source.</Fragment>}
</aside>
