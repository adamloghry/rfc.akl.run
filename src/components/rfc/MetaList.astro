---
import type { RfcRecord, Site } from '../../lib/model';
import RelLinks from './RelLinks.astro';
import { factValueHtml, isDupFact, upper } from './util';
export interface Props { rfc: RfcRecord; site: Site }
const { rfc, site } = Astro.props;
const c = rfc.content || {};
const builds = [...rfc.obsoletes, ...rfc.updates];
const facts = (c.facts || []).filter((x: any) => !isDupFact(x, rfc));
---
<dl class="meta-dl">
<dt>PUBLISHED</dt><dd>{rfc.dateLabel}</dd>
<dt>AUTHORS</dt><dd>{rfc.authors.join(', ')}</dd>
{rfc.organization && <Fragment><dt>ORG</dt><dd>{rfc.organization}</dd></Fragment>}
{rfc.stream && <Fragment><dt>STREAM</dt><dd>{rfc.stream}</dd></Fragment>}
{builds.length > 0 && <Fragment><dt>BUILDS ON</dt><dd><RelLinks nums={builds} site={site} /></dd></Fragment>}
{rfc.obsoletedBy.length > 0 && <Fragment><dt>OBSOLETED BY</dt><dd><RelLinks nums={rfc.obsoletedBy} site={site} /></dd></Fragment>}
{rfc.updatedBy.length > 0 && <Fragment><dt>UPDATED BY</dt><dd><RelLinks nums={rfc.updatedBy} site={site} /></dd></Fragment>}
{facts.map((f: any) => <Fragment><dt>{upper(f.label)}</dt><dd class={String(f.value).length <= 24 && !/\bRFC\s?\d+/.test(f.value) ? 'mono' : undefined} set:html={factValueHtml(f.value, site)} /></Fragment>)}
{rfc.doi && <Fragment><dt>DOI</dt><dd class="mono">{rfc.doi}</dd></Fragment>}
{rfc.errataUrl && <Fragment><dt>ERRATA</dt><dd><a href={rfc.errataUrl}>Reported errata</a></dd></Fragment>}
</dl>
