---
import type { RfcRecord } from '../../lib/model';
import { REPO, starterUrl } from './itutil';
export interface Props { rfc: RfcRecord }
const { rfc } = Astro.props;
const req = `${REPO}/issues/new?template=request.yml&title=Explainer%20request%3A%20RFC%20${rfc.number}`;
---
<div class="it-box it-dash"><span class="it-eye">{rfc.tier === 'index' && rfc.isNew ? 'HELP COVER IT' : 'NO EXPLAINER YET'}</span>
<p>Explainers are JSON files in the repo, so anyone can add one by pull request. Requests are counted from GitHub reactions at build time.</p>
<div class="it-links"><a href={starterUrl(rfc)}>Start the explainer ↗</a><a href={req}>Request an explainer ↗</a><a href="/contribute/">How explainers work</a></div></div>
