---
import type { Site } from '../../lib/model';
import { MAX_REL, shortLabel } from './util';
export interface Props { nums: number[]; site: Site }
const { nums, site } = Astro.props;
const shown = nums.slice(0, MAX_REL);
const more = nums.length - shown.length;
---
{shown.map((n, i) => { const r = site.rfcs.get(n); return <Fragment>{i > 0 && ', '}<a href={`/rfc${n}`}>RFC {n}</a>{r && ` — ${shortLabel(r)}`}</Fragment>; })}{more > 0 && ` and ${more} more`}
