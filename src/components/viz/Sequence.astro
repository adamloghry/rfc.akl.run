---
const { spec, hasSim } = Astro.props;
const CIRCLED = '①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳';
const circled = (n: number) => CIRCLED[n - 1] || `(${n})`;
const lanes = spec.lanes;
const n = lanes.length;
const idx = (k: string) => {
  const i = lanes.findIndex((l: any) => l.key === k);
  if (i < 0) throw new Error(`sequence viz: unknown lane key "${k}"`);
  return i;
};
const rows = spec.messages.map((m: any, i: number) => {
  const a = idx(m.from), b = idx(m.to);
  const num = i + 1;
  return { m, a, b, num, stepId: hasSim ? undefined : `step-${num}`, color: m.color || 'neutral', lo: Math.min(a, b), hi: Math.max(a, b) };
});
---
<div class="viz-card"><div class="seq-head" style={`--n:${n}`}>{lanes.map((l: any) => <span class={l.dashed ? 'is-dim' : undefined}>{l.label}</span>)}</div><ol class="seq-body" style={`--n:${n}`}>{rows.map((r: any) => r.a === r.b
  ? <li class="seq-row is-chip">{lanes.map((l: any, i: number) => <span class={`seq-lane${l.dashed ? ' is-dashed' : ''}`} style={`grid-column:${i + 1}`}></span>)}<div class="seq-msg" style={`grid-column:${r.a + 1}`}><span class="seq-chip"><span id={r.stepId} class="seq-label"><span class="seq-n" aria-hidden="true">{circled(r.num)}</span> {r.m.label}</span></span>{r.m.note ? <span class="seq-note">{r.m.note}</span> : ''}</div></li>
  : <li class="seq-row">{lanes.map((l: any, i: number) => <span class={`seq-lane${l.dashed ? ' is-dashed' : ''}`} style={`grid-column:${i + 1}`}></span>)}<div class={`seq-msg is-${r.color}`} data-dir={r.b > r.a ? 'ltr' : 'rtl'} style={`grid-column:${r.lo + 1} / ${r.hi + 2};--span:${r.hi - r.lo + 1}`}><span id={r.stepId} class="seq-label"><span class="seq-n" aria-hidden="true">{circled(r.num)}</span> {r.m.label}</span><span class="seq-arrow" aria-hidden="true"></span>{r.m.note ? <span class="seq-note">{r.m.note}</span> : ''}</div></li>)}</ol></div>
