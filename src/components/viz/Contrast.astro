---
const { spec } = Astro.props;
const sides = [[spec.left, 'is-left'], [spec.right, 'is-right']];
const [l, r] = sides;
---
<div class="viz-card is-flush ct"><div class={`ct-side ${l[1]}`}><span class="ct-title">{l[0].title}</span><span class="ct-flow">{l[0].from} → <span class="ct-to">{l[0].to}</span></span><span class="ct-desc">{l[0].desc}</span></div><div class="ct-joiner">{String(spec.joiner || 'inverse of').toUpperCase()}</div><div class={`ct-side ${r[1]}`}><span class="ct-title">{r[0].title}</span><span class="ct-flow">{r[0].from} → <span class="ct-to">{r[0].to}</span></span><span class="ct-desc">{r[0].desc}</span></div></div>
