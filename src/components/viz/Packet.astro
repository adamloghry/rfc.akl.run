---
import { sizeLabel, splitValue, valueFor, layout, changedMode } from './packet-layout';
const { spec } = Astro.props;
const width = spec.width || 32;
const modes = spec.modes && spec.modes.length ? spec.modes : [];
const modeKeys = modes.length ? modes : [{ key: '', label: '' }];
const frags = layout(spec.fields, width);
const cellValues = new Map<string, Record<string, string[]>>();
for (const f of spec.fields) {
  const m: Record<string, string[]> = {};
  for (const mk of modeKeys) m[mk.key] = splitValue(valueFor(f, mk.key), layout([f], width).map((x) => x.bits), f.bits);
  cellValues.set(f.key, m);
}
const ruler: number[] = [];
for (let b = 0; b < width; b += 8) ruler.push(b);
const cells = frags.map((fr) => {
  const f = fr.field;
  return {
    fr, f, changed: changedMode(f, modes), vals: cellValues.get(f.key)!,
    label: (f.label || f.key.toUpperCase()) + (fr.part > 0 ? ' (cont.)' : ''),
  };
});
const showSeg = modes.length > 1;
const eyebrow = spec.caption || (spec.title ? `${spec.title}${spec.bytes ? ` · ${spec.bytes} bytes` : ''}` : '');
---
<figcaption class="viz-cap viz-cap-bar"><span class="viz-eyebrow">{eyebrow}</span>{showSeg ? <div class="viz-seg" role="group" aria-label="Packet variant" hidden>{modes.map((m: any, i: number) => <button type="button" data-mode={m.key} aria-pressed={i === 0 ? 'true' : 'false'}>{m.label}</button>)}</div> : ''}</figcaption><div class="pk-body" data-mode={modes.length ? modes[0].key : undefined} data-width={width}><div class="pk-scroll"><div class="pk-ruler" style={`--cols:${width}`}>{ruler.map((b) => <span style="grid-column:span 8">{b}</span>)}</div><div class="pk-grid" style={`--cols:${width}`}>{cells.map((c) => <a class="pk-cell" href={`#field-${c.f.key}`} id={c.fr.part === 0 ? `field-${c.f.key}` : undefined} data-key={c.f.key} data-changed={c.changed} data-name={c.f.name} data-desc={c.f.desc} data-size={sizeLabel(c.f.bits)} style={`grid-column:span ${c.fr.bits}`}><span class="pk-k">{c.label}</span>{modeKeys.map((mk: any, i: number) => <span class="pk-v" data-mode-val={mk.key || undefined} hidden={i > 0}>{c.vals[mk.key][c.fr.part]}</span>)}</a>)}</div></div></div><div class="pk-inspector" aria-live="polite" hidden><span class="pk-i-name"></span><span class="pk-i-desc"></span><span class="pk-i-size"></span></div><table class="viz-packet-table"><caption class="visually-hidden">{spec.title || 'Packet fields'}</caption><thead><tr><th scope="col">Field</th><th scope="col">Name</th><th scope="col">Size</th>{modes.length ? modes.map((m: any) => <th scope="col">{m.label}</th>) : <th scope="col">Value</th>}<th scope="col">Description</th></tr></thead><tbody>{spec.fields.map((f: any) => <tr><th scope="row"><code>{f.key.toUpperCase()}</code></th><td>{f.name}</td><td>{sizeLabel(f.bits)}</td>{modeKeys.map((mk: any) => <td>{valueFor(f, mk.key)}</td>)}<td>{f.desc}</td></tr>)}</tbody></table>
<script>import '../../scripts/packet';</script>
