---
const { spec } = Astro.props;
const lines = String(spec.code).split('\n').map((ln: string) => {
  const m = ln.match(/^(.*?)(\s#\s.*)$/);
  return m ? { text: m[1], comment: m[2] } : { text: ln, comment: null };
});
---
<div class="code-block"><div class="code-head"><span>{spec.title || spec.lang || 'code'}</span><button type="button" class="code-copy" hidden>COPY</button></div><pre data-lang={spec.lang}><code>{lines.map((l, i) => <Fragment>{l.text}{l.comment !== null && <span class="code-c">{l.comment}</span>}{i < lines.length - 1 ? '\n' : ''}</Fragment>)}</code></pre></div>
<script>import '../../scripts/packet';</script>
