---
const { spec } = Astro.props;
---
<div class="cmp"><table class="cmp-table"><thead><tr>{spec.columns.map((c: any) => <th scope="col">{c}</th>)}</tr></thead><tbody>{spec.rows.map((r: any) => <tr class={r.self ? 'is-self' : undefined}>{r.cells.map((c: any, i: number) => i === 0 ? <th scope="row">{c}{r.self && <Fragment>{' '}<span class="cmp-self">THIS RFC</span></Fragment>}</th> : <td>{c}</td>)}</tr>)}</tbody></table></div>
