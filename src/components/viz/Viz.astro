---
import type { RfcRecord } from '../../lib/model';
import { normalizeViz, isVizType } from './validate';
import Packet from './Packet.astro';
import SequenceSim from './SequenceSim.astro';
import Sequence from './Sequence.astro';
import CompareTable from './CompareTable.astro';
import Contrast from './Contrast.astro';
import KeyGrid from './KeyGrid.astro';
import Layers from './Layers.astro';
import Timeline from './Timeline.astro';
import StateMachine from './StateMachine.astro';
import Tree from './Tree.astro';
import Opcodes from './Opcodes.astro';
import Code from './Code.astro';

export interface Props { spec: any; rfc: RfcRecord }

const COMPONENTS = {
  packet: Packet, 'sequence-sim': SequenceSim, sequence: Sequence, 'compare-table': CompareTable,
  contrast: Contrast, 'key-grid': KeyGrid, layers: Layers, timeline: Timeline,
  'state-machine': StateMachine, tree: Tree, opcodes: Opcodes, code: Code,
} as const;

const { spec: rawSpec, rfc } = Astro.props;
const spec = normalizeViz(rawSpec);
if (!spec || !isVizType(spec.type)) throw new Error(`unknown viz type: ${spec && spec.type}`);
const list: any[] = rfc && rfc.content && Array.isArray(rfc.content.viz) ? rfc.content.viz : [];
const found = list.indexOf(rawSpec);
const index = found >= 0 ? found : 0;
const id = spec.id || `${spec.type}-${index}`;
const hasSim = list.some((v) => v && v.type === 'sequence-sim');
const Component = COMPONENTS[spec.type];
---
<figure class={`viz viz-${spec.type}`} id={id} data-viz={spec.type}>{spec.caption && spec.type !== 'packet' && spec.type !== 'sequence-sim' ? <figcaption class="viz-cap">{spec.caption}</figcaption> : ''}<Component spec={spec} rfc={rfc} hasSim={hasSim} /></figure>
