---
const { spec } = Astro.props;
const label = (k: string) => (spec.states.find((s: any) => s.key === k) || { label: k }).label;
---
<div class="viz-card"><ul class="sm-states">{spec.states.map((s: any) => <li class={`sm-state${s.initial ? ' is-initial' : ''}${s.final ? ' is-final' : ''}`}>{s.label}{s.initial && <Fragment>{' '}<span class="sm-flag">start</span></Fragment>}{s.final && <Fragment>{' '}<span class="sm-flag">end</span></Fragment>}</li>)}</ul><table class="sm-table"><thead><tr><th scope="col">From</th><th scope="col">To</th><th scope="col">Event</th></tr></thead><tbody>{spec.transitions.map((t: any) => <tr><td>{label(t.from)}</td><td>{label(t.to)}</td><td>{t.label}</td></tr>)}</tbody></table></div>
