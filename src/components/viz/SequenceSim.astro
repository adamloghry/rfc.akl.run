---
import SimStep from './SimStep.astro';
const { spec, rfc } = Astro.props;
// "</" and "<!" can never terminate or double-escape the script element.
const safeJson = JSON.stringify(spec).replace(/<\//g, '<\\/').replace(/<(?=[a-zA-Z!?])/g, '\\u003c');
const t = spec.table;
const failing = spec.failureSteps && spec.failureSteps.length;
---
<figcaption class="viz-cap viz-cap-bar"><span class="viz-eyebrow">{spec.caption || 'simulation'}</span></figcaption><div class="sim" data-rfc={rfc && rfc.number}><div class="sim-fallback"><h3 class="sim-title">{spec.title}</h3><ol class="sim-steps">{spec.steps.map((s: any, i: number) => <SimStep s={s} id={`step-${i + 1}`} />)}</ol>{failing ? <Fragment><h4 class="sim-fail-h">{spec.router ? `Failure branch: with the server behind a ${String(spec.router.label || 'router').toLowerCase()}` : 'Failure branch'}</h4><ol class="sim-steps sim-failure-steps">{spec.failureSteps.map((s: any, i: number) => <SimStep s={s} id={`fail-${i + 1}`} />)}</ol></Fragment> : ''}{t ? <table class="sim-table"><caption>{t.title}{t.caption && <Fragment>{' '}<code>{t.caption}</code></Fragment>}</caption><thead><tr>{t.columns.map((c: any) => <th scope="col">{c}</th>)}</tr></thead><tbody>{t.rows.map((r: any, i: number) => <tr class={i === t.matchRow ? 'is-match' : undefined}>{r.map((c: any) => <td>{c}</td>)}</tr>)}</tbody></table> : ''}{spec.replacedBy && spec.replacedBy.length ? <div class="sim-replaced"><h4>What replaced it</h4><ul>{spec.replacedBy.map((r: any) => <li><a href={`/rfc${r.number}`}>{r.label} · RFC {r.number}</a></li>)}</ul>{spec.replacedNote ? <p>{spec.replacedNote}</p> : ''}</div> : ''}</div><script type="application/json" class="sim-data" set:html={safeJson}></script></div>
<script>import '../../scripts/sim';</script>
