---
const { spec } = Astro.props;
---
<ol class="tl">{spec.events.map((e: any) => <li><span class="tl-y">{e.year}</span><span class="tl-dot" aria-hidden="true"></span><span class="tl-l">{e.rfc ? <a href={`/${e.rfc}/`}>{e.label}</a> : e.label}</span>{e.rfc ? <span class="tl-r">RFC {e.rfc}</span> : ''}</li>)}</ol>
