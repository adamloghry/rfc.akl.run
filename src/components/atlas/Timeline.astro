---
import type { Site } from '../../lib/model';
import { timelineModel } from './atlas-data';
const { site } = Astro.props as { site: Site };
const { cols, axis } = timelineModel(site);
---
<section class="at-timeline">
<div class="at-row-between at-head"><div class="at-title"><span class="at-eyebrow">TIMELINE</span><h2 class="at-h2">Covered RFCs by year published</h2></div><span class="at-note">Hover a bar for the year’s RFCs</span></div>
<div class="at-panel at-tl-panel"><div class="at-tl">{cols.map((c) => <div class="at-tl-col" title={c.tip}><div class="at-tl-b" style={`height:${c.hb}`}></div><div class="at-tl-f" style={`height:${c.hf}`}></div></div>)}</div><div class="at-tl-axis">{axis.map((y) => <span>{y}</span>)}</div></div>
</section>
