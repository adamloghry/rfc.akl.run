---
import type { Site } from '../../lib/model';
import { fmt, rampModel } from './atlas-data';
const { site } = Astro.props as { site: Site };
const ramp = rampModel(site);
---
<section class="at-map" id="map" aria-label="Every RFC">
<div class="at-row-between at-head">
<div class="at-title"><span class="at-eyebrow">EVERY RFC</span></div>
<div class="at-legend" role="group" aria-label="Cell shade is the status; the chips below filter by area">{ramp.map((s) => <span><i class={`at-sw at-sw-${s.cls}`}></i>{s.label} <em>{fmt(s.count)}</em></span>)}<span><i class="at-hatch"></i>Not issued or reserved</span></div>
</div>
<div class="at-chips" role="group" aria-label="Filter by area"><button type="button" class="at-chip" data-cat="" aria-pressed="true">All areas</button>{site.categories.map((k) => <button type="button" class="at-chip" data-cat={k.key} aria-pressed="false">{k.name}</button>)}</div>
<div class="at-panel at-canvas-wrap">
<canvas class="at-canvas" id="atlas-map" tabindex="0" role="img" aria-label="Coverage map of every RFC number, one cell each. Focus the map, use the arrow keys to move between RFCs, and press Enter to open the selected RFC page." data-max={site.max}></canvas>
<noscript><p class="at-note">The interactive map needs JavaScript. <a href="/areas">Browse every RFC by area instead.</a></p></noscript>
<div class="at-caption" aria-live="polite"><span><b class="at-cap-label">Hover the map</b> <span class="at-cap-detail">— darker means closer to a standard; hover for the title, status, area and year.</span></span><span class="at-cap-hint">each cell = one RFC · every cell is a page · click to open</span></div>
</div>
</section>
<script>
  import '../../scripts/atlas';
</script>
