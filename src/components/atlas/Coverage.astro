---
import type { Site } from '../../lib/model';
import { coverageModel } from './atlas-data';
const { site } = Astro.props as { site: Site };
const m = coverageModel(site);
---
<section class="at-cov">
<div class="at-panel at-goal">
<div class="at-row-between"><span class="at-eyebrow">GOAL · EVERY RFC, EXPLAINED</span><a class="at-link" href="/coverage/">Coverage report →</a></div>
<div class="at-stat"><span class="at-stat-num">{m.pct}</span><span class="at-stat-txt">of {m.total} RFCs have more than an index page</span></div>
<div class="at-bar at-bar-lg" role="img" aria-label={`${m.pct} covered`}><span style={`width:${m.barDeep};background:var(--accent)`}></span><span style={`width:${m.barSummary};background:var(--accent-2)`}></span></div>
<div class="at-ladder">{m.ladder.map((l) => <div class="at-step" style={`border-top-color:${l.color}`}><span class="at-step-num">{l.count}</span><span class="at-step-label">{l.label}</span><span class="at-step-hint">{l.hint}</span></div>)}</div>
</div>
<div class="at-panel at-fresh">
<div class="at-row-between"><span class="at-eyebrow">JUST PUBLISHED</span><a class="at-link" href="/feed.xml">Follow (RSS)</a></div>
<div class="at-fresh-list">{m.fresh.map((r) => <a class="at-fresh-row" href={r.url}><span class="at-fresh-n">RFC {r.number}</span><span class="at-fresh-body"><span class="at-fresh-title">{r.title}</span><span class="at-fresh-meta">{r.meta}</span></span></a>)}</div>
<span class="at-note">New RFCs get an index page the day they're published — no manual step.</span>
</div>
</section>
