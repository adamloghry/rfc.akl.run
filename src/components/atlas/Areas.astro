---
import type { Site } from '../../lib/model';
import { areasModel } from './atlas-data';
const { site } = Astro.props as { site: Site };
const list = areasModel(site);
---
<section class="at-areas" id="areas">
<div class="at-title"><span class="at-eyebrow">AREAS</span><h2 class="at-h2">Browse by what it does</h2></div>
<div class="at-agrid">{list.map((a) => <a class="at-acard" href={`/areas/${a.key}/`}><div class="at-row-between"><span class="at-acard-name">{a.name}</span><span class="at-acard-count">{a.count} covered</span></div><div class="at-bar"><span style={`width:${a.wf};background:var(--accent)`}></span><span style={`width:${a.ws};background:var(--accent-2)`}></span></div><span class="at-acard-ex">{a.examples}</span></a>)}</div>
</section>
