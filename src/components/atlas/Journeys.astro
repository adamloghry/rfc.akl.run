---
import type { Site } from '../../lib/model';
import { journeysModel, rfcPath } from './atlas-data';
const { site } = Astro.props as { site: Site };
const { feat, others } = journeysModel(site);
const steps = feat?.steps || [];
---
<section class="at-journeys" id="journeys">
<div class="at-row-between at-head"><div class="at-title"><span class="at-eyebrow">JOURNEYS</span><h2 class="at-h2">Start from a question, not a number</h2></div><a class="at-link at-link-lg" href="/journeys/">All journeys →</a></div>
{!feat ? <p class="at-note">Journeys are on their way.</p> : (
<div class="at-jgrid"><a class="at-feature" href={`/journeys/${feat.slug}/`}>
<span class="at-feature-eyebrow">{steps.length} STEPS · {rfcPath(feat).length} RFCS</span>
<span class="at-feature-title">{feat.title}</span>
<span class="at-feature-desc">{feat.description || ''}</span>
<span class="at-feature-steps">{steps.map((s: any, i: number) => <span class="at-jstep"><span class="at-jstep-n">{i + 1}</span><span class="at-jstep-title">{s.title}</span><span class="at-jstep-rfcs">{(s.rfcs || []).map((r: any) => r.number).join(' · ')}</span></span>)}</span>
</a>{others.map((j: any) => <a class="at-jcard" href={`/journeys/${j.slug}/`}><span class="at-jcard-meta">{(j.steps || []).length} STEPS · {rfcPath(j).length} RFCS</span><span class="at-jcard-title">{j.title}</span><span class="at-jcard-path">{rfcPath(j).slice(0, 4).join(' → ')}</span></a>)}</div>
)}
</section>
