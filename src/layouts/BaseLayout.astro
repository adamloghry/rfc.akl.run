---
/**
 * Page shell.
 * Slots: default → <main id="main">, "footer" → .footer-extra row, "head" → extra <head> content.
 */
import '../styles/global.css';
import SiteHeader from '../components/chrome/SiteHeader.astro';
import ReaderHeader from '../components/chrome/ReaderHeader.astro';
import Footer from '../components/chrome/Footer.astro';
import sans400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import sans600 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url';

export interface Props {
  title: string;
  description?: string;
  /** site path with a leading slash and no trailing slash, e.g. "/rfc903" or "/areas/core" (canonical = https://rfc.akl.run + path) */
  path: string;
  palette?: 'warm' | 'cool';
  header?: 'site' | 'reader';
  breadcrumb?: { label: string; href?: string }[];
  /** nav key for header "site": atlas | journeys | areas | glossary */
  active?: string;
  container?: 'reader' | 'atlas' | 'index';
  ogType?: string;
  robots?: string;
  /** rendered as <meta name="rfc-tier"> (read by scripts/check-dist.ts for page budgets): index|summary|explainer|interactive|not-issued */
  tier?: string;
}

const ORIGIN = 'https://rfc.akl.run';
const { title, description = '', path, tier, header = 'reader', breadcrumb, active, ogType = 'website', robots = 'index, follow' } = Astro.props;
const palette = Astro.props.palette === 'cool' ? 'cool' : 'warm';
const cont = ['reader', 'atlas', 'index'].includes(Astro.props.container ?? '') ? Astro.props.container! : (header === 'site' ? 'atlas' : 'reader');
const canonical = ORIGIN + path;
// Optional cookieless Cloudflare Web Analytics; the CSP in _headers gains the beacon origins when this is set.
const beaconToken = String(import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? '').trim();

// Pre-paint: theme (handoff README §Theme) extended with the reading level.
const PREPAINT = "(function(){try{var s=localStorage.getItem('rfc-theme');var t=s||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.setAttribute('data-theme',t);var l=new URLSearchParams(location.search).get('level')||localStorage.getItem('rfc-level');if(l==='eli5')document.documentElement.setAttribute('data-level','eli5');}catch(e){}})();";
const FAVICON = 'data:image/svg+xml,' + encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>\u{1F4E1}</text></svg>");
---
<!doctype html>
<html lang="en" class={`pal-${palette}`}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline set:html={PREPAINT}></script>
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={robots}>
<link rel="canonical" href={canonical}>
<meta property="og:site_name" content="rfc.akl.run">
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
{/* theme-color values mirror the --bg tokens (warm/cool x light/dark) in src/styles/tokens.css */}
<meta name="theme-color" content={palette === 'warm' ? '#f6f5f1' : '#f7f7f8'} media="(prefers-color-scheme: light)">
<meta name="theme-color" content={palette === 'warm' ? '#121110' : '#0e0f12'} media="(prefers-color-scheme: dark)">
<link rel="icon" href={FAVICON}>
<link rel="preload" as="font" type="font/woff2" crossorigin href={sans400}>
<link rel="preload" as="font" type="font/woff2" crossorigin href={sans600}>
{tier && <meta name="rfc-tier" content={tier}>}
<slot name="head" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{header === 'site' ? <SiteHeader active={active} container={cont} /> : <ReaderHeader breadcrumb={breadcrumb} container={cont} />}
<main id="main">
<slot />
</main>
{Astro.slots.has('footer')
  ? <Footer container={cont}><slot name="footer" /></Footer>
  : <Footer container={cont} />}
<script>
  import '../scripts/theme';
  import '../scripts/search';
</script>
{beaconToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beaconToken })}></script>}
</body>
</html>
