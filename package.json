{
  "name": "rfc-akl-run",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:offline": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "lint": "node --import tsx scripts/lint-content.ts",
    "check": "node --import tsx scripts/check-dist.ts",
    "check:types": "astro check",
    "parity": "node --import tsx scripts/parity.ts",
    "deploy": "astro build && node --import tsx scripts/check-dist.ts && ${WRANGLER_BIN:-wrangler} deploy",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "biome format --write .",
    "lint:code": "biome check .",
    "preview:cf": "${WRANGLER_BIN:-wrangler} dev --local --port 8787",
    "refresh-index": "node --import tsx scripts/refresh-index.ts",
    "preflight": "node --import tsx scripts/check-dist.ts",
    "deploy:preview": "astro build && node --import tsx scripts/check-dist.ts && ${WRANGLER_BIN:-wrangler} versions upload",
    "explain:fetch": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/explain/fetch-texts.ts",
    "explain:plan": "node --import tsx scripts/explain/plan.ts",
    "explain:validate": "node --import tsx scripts/explain/validate.ts",
    "explain:merge": "node --import tsx scripts/explain/merge.ts",
    "explain:glossary": "node --import tsx scripts/explain/glossary-finalize.ts",
    "explain:status": "node --import tsx scripts/explain/status.ts",
    "explain:spec": "node --import tsx scripts/explain/gen-spec.ts"
  },
  "dependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.4.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@playwright/test": "1.59.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "fast-xml-parser": "^5.11.2",
    "happy-dom": "21.0.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "4.93.0"
  },
  "type": "module"
}
