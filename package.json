{
  "name": "rfc-akl-run",
  "version": "2.0.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.js",
    "build:offline": "node scripts/build.js --offline",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "node scripts/lint-content.js",
    "check": "node scripts/check-dist.js",
    "serve": "python3 -m http.server 8080 --directory dist",
    "deploy": "node scripts/build.js && node scripts/check-dist.js && npx --yes wrangler@4 deploy"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "ajv": "^8.20.0",
    "fast-xml-parser": "^5.11.2"
  }
}
