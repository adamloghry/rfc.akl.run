{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.viz.config.ts",
    "astro.config.mjs"
  ],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "allowJs": false,
    "types": ["node"]
  }
}
