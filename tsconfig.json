{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "astro.config.mjs"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "scripts/lib",
    "scripts/pages",
    "scripts/templates",
    "scripts/*.js"
  ],
  "compilerOptions": {
    "noImplicitAny": false,
    "allowJs": false,
    "types": [
      "node"
    ],
    "useUnknownInCatchVariables": false
  }
}