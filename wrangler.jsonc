{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare Pages project (static only, no Functions): serves dist/ from Cloudflare's network.
  // Pages serves foo.html at /foo, redirects /foo/ and /foo.html to /foo (308), and serves the top-level
  // 404.html with status 404 for unknown paths. dist/_headers and dist/_redirects are applied as-is.
  "name": "rfc-akl-run",
  "compatibility_date": "2026-05-01",
  "pages_build_output_dir": "./dist"
  // Custom domains (rfc.akl.run, and the alias rfcs.akl.run) are attached in the dashboard:
  // Workers & Pages > rfc-akl-run > Custom domains. Pages config cannot declare them. See docs/cloudflare.md.
}
