{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Assets-only Worker (no script): serves dist/ from Cloudflare's network. Workers Builds deploys trunk
  // with `npx wrangler deploy`; see docs/cloudflare.md.
  "name": "rfc-akl-run",
  "compatibility_date": "2026-05-01",
  // Enable the *.workers.dev URL and per-version preview URLs (Workers Builds gives non-production branches one).
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Pages are <path>.html: /rfc903 serves rfc903.html (200), /rfc903/ redirects to /rfc903.
    "html_handling": "auto-trailing-slash"
  }
  // Attach rfc.akl.run in the dashboard (rfc-akl-run > Settings > Domains & Routes > Add > Custom domain), or
  // declare it here so `wrangler deploy` manages it (needs the akl.run zone in the same account):
  // ,"routes": [{ "pattern": "rfc.akl.run", "custom_domain": true }]
}
