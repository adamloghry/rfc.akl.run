{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Assets-only Worker (no script): serves dist/ from Cloudflare's network.
  "name": "rfc-akl-run",
  "compatibility_date": "2026-05-01",
  // Enable the *.workers.dev URL and per-version preview URLs, so `wrangler versions upload`
  // (see .github/workflows/preview.yml) returns a preview URL for each PR.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
  // The rfc.akl.run custom domain is already attached in the Cloudflare dashboard
  // (Workers & Pages > rfc-akl-run > Settings > Domains & Routes), so declaring it here is optional.
  // Declaring it makes `wrangler deploy` manage the attachment from code:
  // ,"routes": [{ "pattern": "rfc.akl.run", "custom_domain": true }]
}
