{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.{ts,js,mjs,css,json}",
      "scripts/**/*.{ts,js,mjs}",
      "test/**/*.{ts,js,mjs}",
      "e2e/**/*.{ts,js,mjs}",
      "*.{ts,js,mjs,json,jsonc}",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.astro",
      "!**/.work",
      "!**/.superpowers",
      "!**/.cache",
      "!**/.wrangler",
      "!**/test-results",
      "!**/playwright-report",
      "!content",
      "!docs",
      "!**/*.astro",
      "!flake.lock",
      "!package-lock.json",
      "!test/fixtures",
      // sandbox/editor dotfiles at the repo root that are not part of the project
      "!.mcp.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "overrides": [
    {
      // Stylesheets: !important is deliberate in print.css and the viz/base overrides (it must beat inline
      // style attributes and component styles), and rule order encodes the cascade, so descending
      // specificity is intentional.
      "includes": ["src/styles/**/*.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" }, "style": { "noDescendingSpecificity": "off" } } }
    },
    {
      // Tests and e2e: a non-null assertion on a lookup that must exist fails the test loudly, which is the intent.
      "includes": ["test/**", "e2e/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      // These modules handle untyped JSON/XML (content files validated at lint time, the RFC Editor XML parse
      // result, view-models over loosely shaped journey/term data); their shapes are checked at runtime by
      // validators and schemas rather than by static types.
      "includes": [
        "src/components/viz/validate.ts",
        "src/components/viz/packet-layout.ts",
        "src/components/atlas/atlas-data.ts",
        "src/components/pages/contribute-data.ts",
        "src/components/pages/util.ts",
        "src/lib/rfc-index.ts",
        "scripts/check-dist.ts"
      ],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
